# Proveedor de datos: "local" (localStorage, sin backend ni login) o "supabase".
VITE_DATA_PROVIDER=local

# Solo si usas Supabase → Project Settings → API
# VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Recordatorios push (opcional). Genera el par con `npm run vapid`:
# la clave PÚBLICA va aquí; la PRIVADA solo en los secretos de la Edge Function (nunca en el frontend).
# VITE_VAPID_PUBLIC_KEY=
